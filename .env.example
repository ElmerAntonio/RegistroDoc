# =======================================================================
#               RegistroDoc Pro — Configuración de Entorno (.env)
# =======================================================================
# Este archivo sirve como plantilla para el entorno local.
# Al iniciar la aplicación por primera vez, el sistema generará una 
# semilla criptográfica REGISTRODOC_MASTER_SALT segura y la guardará 
# automáticamente en un archivo local llamado ".env".
#
# IMPORTANTE: NO comparta su archivo ".env" definitivo ni lo suba a 
# repositorios públicos, ya que encripta la configuración de su escuela.
#
REGISTRODOC_MASTER_SALT=
